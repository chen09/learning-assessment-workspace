# Local PostgreSQL development database. Copy this file to .env before starting Docker Compose.
POSTGRES_DB=learning_assessment
POSTGRES_USER=learning_app
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_PORT=55432

# Supabase production project. Never commit real values.
SUPABASE_DB_PASSWORD=replace-with-your-supabase-database-password
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
