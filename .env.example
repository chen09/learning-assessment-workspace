# Supabase. Use local CLI values for development and hosted values in production.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=replace-with-your-supabase-database-password

# Browser-safe copies embedded in the static web build.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
WEB_PORT=3000

# FastAPI and worker. The local default targets `npx supabase start`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
CHILD_SESSION_SECRET=replace-with-at-least-32-random-bytes
AI_PROVIDER=fixture
REPOSITORY_BACKEND=memory

# Production-only integrations.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
SMTP_URL=
